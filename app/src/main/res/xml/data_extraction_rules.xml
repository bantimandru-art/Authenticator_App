<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. See backup_rules.xml for why the accounts file is excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="accounts.enc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts.enc" />
    </device-transfer>
</data-extraction-rules>
