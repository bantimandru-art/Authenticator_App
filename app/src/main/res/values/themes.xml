<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MyAuth" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/inverse_primary</item>

        <!-- Fonts come from the type scale below. Don't set fontFamily on the theme:
             it wins over textAppearance and flattens every weight to regular. -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.MyAuth.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.MyAuth.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.MyAuth.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MyAuth.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.MyAuth.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.MyAuth.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MyAuth.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.MyAuth.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.MyAuth.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.MyAuth.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.MyAuth.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.MyAuth.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.MyAuth.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.MyAuth.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.MyAuth.Large</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MyAuth.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MyAuth.BottomSheet</item>
        <item name="textInputStyle">@style/Widget.MyAuth.TextInput</item>
        <item name="snackbarStyle">@style/Widget.MyAuth.Snackbar</item>
    </style>

    <style name="Theme.MyAuth" parent="Base.Theme.MyAuth" />

    <!-- The scanner is always dark, whatever the system theme -->
    <style name="Theme.MyAuth.Scanner" parent="Base.Theme.MyAuth">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <style name="ShapeAppearance.MyAuth.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.MyAuth.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.MyAuth.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ThemeOverlay.MyAuth.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/surface_container_lowest</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.MyAuth.Title</item>
    </style>

    <style name="MaterialAlertDialog.MyAuth.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.MyAuth.HeadlineSmall</item>
    </style>

    <style name="ThemeOverlay.MyAuth.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MyAuth.BottomSheet</item>
    </style>

    <style name="Widget.MyAuth.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_container_lowest</item>
    </style>

    <style name="Widget.MyAuth.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.MyAuth.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.MyAuth.Small</item>
    </style>

    <style name="Widget.MyAuth.AccountCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="cardCornerRadius">22dp</item>
    </style>

    <style name="Widget.MyAuth.SearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/surface_container_lowest</item>
        <item name="boxStrokeColor">@color/search_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/on_surface_variant</item>
    </style>

    <style name="Widget.MyAuth.SheetOption" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.MyAuth.SheetOption.Icon" parent="">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:padding">10dp</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.MyAuth.ScannerButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="iconTint">@color/white</item>
    </style>
</resources>
