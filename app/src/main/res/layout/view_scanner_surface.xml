<?xml version="1.0" encoding="utf-8"?>
<!--
    Replacement for zxing's default scanner layout. The library looks these three views
    up by id, so the ids must stay as they are. The laser and result dots are switched off;
    our own frame is drawn on top in activity_scanner.xml.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_height="@dimen/scanner_frame_size"
        app:zxing_framing_rect_width="@dimen/scanner_frame_size" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@android:color/transparent"
        app:zxing_result_view="@color/scanner_scrim"
        app:zxing_viewfinder_laser_visibility="false"
        app:zxing_viewfinder_mask="@color/scanner_scrim" />

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</merge>
